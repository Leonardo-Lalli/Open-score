# Configurazione del server Open Score per la LAN scolastica.
# Copiare questo file in "open-score.env" e cambiare i valori.
# Il database parte vuoto: non vengono creati tornei dimostrativi.
# Il file open-score.env contiene segreti: non va pubblicato su Git.

# Account bootstrap del primo docente. Al primo avvio viene creato se non
# esiste. Gli altri docenti si creano dalla cartella torneo-lab con:
#   python manage.py create-teacher professore@scuola.it --name "Nome"
TORNEO_ADMIN_EMAIL=prof@scuola.it
TORNEO_ADMIN_PASSWORD=cambiare-questa-password

# "Sono uno studente" permette la consultazione anonima dei tornei pubblicati.
# Con Account studente si accede o ci si registra; associazione/invito abilita
# le proposte per la propria squadra. Questa opzione disabilita tutte le nuove
# registrazioni se impostata a false: non implementa la registrazione solo da QR.
# TORNEO_ALLOW_REGISTRATION=true

# Per pubblicazione HTTPS usare mode service e origin/host espliciti.
# Il valore demo mantiene la prova locale; non viene creato un dataset demo.
# TORNEO_MODE=service
# TORNEO_PUBLIC_ORIGIN=https://tornei.example.test

# Indirizzi con cui il server viene raggiunto. Aggiungere l'IP del computer
# nella LAN e, se usato, il nome DNS. 127.0.0.1 e localhost sono sempre ammessi.
TORNEO_ALLOWED_HOSTS=192.168.1.50,open-score.local

# Segreto di firma dei cookie di sessione. Se assente viene creato in
# torneo-lab/data/session.secret e riusato a ogni avvio.
# TORNEO_SECRET=segreto-lungo-e-casuale

# Durata della sessione in ore (predefinito 12).
# TORNEO_SESSION_HOURS=12

# Mettere 1 solo se il server e pubblicato in HTTPS dietro un reverse proxy:
# aggiunge Secure al cookie e l'intestazione HSTS.
# TORNEO_COOKIE_SECURE=0

# Percorso del database. Predefinito: torneo-lab/data/open_score.sqlite3.
# TORNEO_DB_PATH=C:\OpenScore\torneo-lab\data\open_score.sqlite3
