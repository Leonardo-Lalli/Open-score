:root {
  --bg: #f6f7f2;
  --paper: #fff;
  --ink: #1c3028;
  --muted: #738077;
  --line: #e3e8df;
  --lime: #d6f473;
  --dark: #182923;
  --green: #2d694d;
  --radius: 17px;
  font-family: "Segoe UI", Arial, sans-serif;
  color: var(--ink);
  background: var(--bg);
  font-synthesis: none;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
}
button,
input,
select,
textarea {
  font: inherit;
}
button,
a,
input,
select,
textarea {
  -webkit-tap-highlight-color: transparent;
}
button {
  cursor: pointer;
}
button:disabled {
  cursor: default;
}
a {
  color: inherit;
}
button {
  color: inherit;
}
button:focus-visible,
a:focus-visible {
  outline: 3px solid #77a82c;
  outline-offset: 4px;
}
input:focus,
select:focus,
textarea:focus {
  outline: 2px solid #8db14a;
  outline-offset: 2px;
}
.skip-link {
  position: fixed;
  top: -60px;
  left: 20px;
  z-index: 99;
  background: var(--lime);
  padding: 12px;
}
.skip-link:focus {
  top: 8px;
}
.icon {
  width: 20px;
  height: 20px;
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.sidebar {
  position: fixed;
  width: 248px;
  inset: 0 auto 0 0;
  background: var(--dark);
  color: #e8eee9;
  padding: 32px 22px 0;
  display: flex;
  flex-direction: column;
  z-index: 20;
}
.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  text-decoration: none;
  font-size: 27px;
  font-weight: 750;
  letter-spacing: -1.2px;
}
.brand-light {
  font-weight: 350;
  color: #c1ccbf;
}
.brand small {
  display: block;
  font-size: 8px;
  letter-spacing: 2.1px;
  font-weight: 600;
  color: #9fae9f;
  margin-top: 5px;
}
.workspace {
  margin: 36px 0 32px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  font-weight: 600;
}
.workspace-avatar {
  display: grid;
  place-items: center;
  background: #304338;
  width: 34px;
  height: 34px;
  border-radius: 9px;
  font-size: 10px;
  color: var(--lime);
}
.workspace small {
  display: block;
  font-size: 10px;
  color: #98a99f;
  font-weight: 400;
  margin-top: 3px;
}
.workspace-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--lime);
  margin-left: auto;
}
.nav-label {
  font-size: 9px;
  letter-spacing: 1.7px;
  color: #91a498;
  margin: 0 10px 12px;
}
.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 13px;
  background: none;
  border: 0;
  border-radius: 9px;
  color: #bfcbbf;
  text-align: left;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 5px;
}
.nav-item.active {
  background: #304631;
  color: var(--lime);
}
.nav-item:hover,
.event-nav button:hover {
  background: #283d30;
}
.nav-plus {
  margin-left: auto;
  font-size: 20px;
  font-weight: 300;
}
.events-label {
  display: flex;
  justify-content: space-between;
  margin-top: 32px;
}
.events-label span {
  color: #c7d1c5;
}
.event-nav {
  overflow: auto;
  max-height: 34vh;
}
.event-nav button {
  padding: 11px 10px;
  display: flex;
  align-items: center;
  gap: 9px;
  border: 0;
  background: none;
  color: #b9c6b8;
  text-align: left;
  font-size: 11px;
  width: 100%;
  border-radius: 7px;
  line-height: 1.4;
}
.event-nav button.active {
  color: var(--lime);
  background: #263b2e;
}
.event-dot {
  height: 6px;
  width: 6px;
  flex-shrink: 0;
  border: 1px solid #9eb58e;
  border-radius: 2px;
}
.event-nav button:nth-child(2n) .event-dot {
  border-color: #c4ac8c;
}
.sidebar-muted {
  font-size: 11px;
  color: #98a99f;
  padding: 0 10px;
}
.sidebar-bottom {
  margin-top: auto;
  padding-top: 25px;
}
.idea-card {
  border: 1px solid #3a4b3f;
  border-radius: 12px;
  background: linear-gradient(120deg, #253e2e, #213129);
  padding: 17px;
}
.idea-card > .icon {
  color: var(--lime);
  width: 23px;
  height: 23px;
  display: block;
  margin-bottom: 13px;
}
.idea-card strong {
  font-size: 12px;
}
.idea-card p {
  font-size: 11px;
  line-height: 1.7;
  color: #a5b6a6;
  margin: 7px 0 12px;
}
.idea-card button {
  display: flex;
  justify-content: space-between;
  width: 100%;
  border: 0;
  padding: 0;
  background: none;
  color: var(--lime);
  font-size: 10px;
  font-weight: 650;
}
.local-status {
  border-top: 1px solid #304237;
  margin-top: 25px;
  padding: 21px 0;
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 10px;
  color: #a8b8aa;
}
.local-status i,
.demo-label i {
  display: inline-block;
  width: 5px;
  height: 5px;
  background: #a8ce6e;
  border-radius: 50%;
}
.local-status span {
  margin-left: auto;
  font-size: 9px;
}
.app-shell {
  margin-left: 248px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}
.topbar {
  height: 77px;
  border-bottom: 1px solid var(--line);
  padding: 0 42px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  background: #fbfcf8;
}
.breadcrumb {
  font-size: 11px;
  display: flex;
  align-items: center;
  gap: 16px;
  color: var(--muted);
}
.breadcrumb strong {
  font-weight: 600;
  color: var(--ink);
}
.crumb-slash {
  color: #bdc6b9;
}
.top-actions {
  display: flex;
  gap: 22px;
  align-items: center;
}
.demo-label {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.4px;
  color: #778370;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid var(--line);
  background: white;
  border-radius: 8px;
  padding: 12px 18px;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  line-height: 1.4;
  white-space: nowrap;
}
.button:hover {
  background: #f1f4ea;
}
.button.primary {
  background: var(--ink);
  color: white;
  border-color: var(--ink);
}
.button.primary:hover {
  background: #304b3d;
}
.button.lime {
  background: var(--lime);
  color: var(--ink);
  border-color: var(--lime);
}
.button.lime:hover {
  background: #c9e965;
}
.button.compact {
  font-size: 11px;
  padding: 9px 13px;
}
.button .icon {
  width: 16px;
  height: 16px;
}
.button.ghost {
  background: none;
  border-color: transparent;
}
.button.danger {
  color: #b14135;
  background: #fff3ee;
  border-color: #f0d9d2;
}
.button:disabled {
  opacity: 0.45;
}
.icon-button {
  border: 0;
  background: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  border-radius: 7px;
}
.icon-button:hover {
  background: #e7ecdf;
}
#mobile-menu {
  display: none;
}
main {
  width: 100%;
  max-width: 1500px;
  padding: 37px 42px 30px;
  margin: 0 auto;
  flex: 1;
}
h1,
h2,
h3,
p {
  margin-top: 0;
}
h1 {
  font-size: 36px;
  letter-spacing: -1.3px;
  line-height: 1.16;
  margin-bottom: 12px;
  font-weight: 650;
}
h2 {
  font-size: 20px;
  letter-spacing: -0.5px;
  font-weight: 650;
}
h3 {
  font-size: 15px;
  letter-spacing: -0.2px;
}
p {
  line-height: 1.7;
}
.muted {
  color: var(--muted);
}
.eyebrow {
  text-transform: uppercase;
  letter-spacing: 1.6px;
  font-size: 9px;
  font-weight: 650;
  color: var(--muted);
  margin: 0 0 13px;
  display: flex;
  align-items: center;
  gap: 9px;
}
.eyebrow .line {
  width: 21px;
  height: 1px;
  background: var(--green);
}
.page-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 26px;
}
.page-heading > div > p:last-child {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 0;
}
.date-note {
  color: var(--muted);
  font-size: 10px;
  padding-bottom: 3px;
}
.hero {
  border-radius: var(--radius);
  background: #eaf0df;
  min-height: 229px;
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  overflow: hidden;
  border: 1px solid #dfe7d5;
  margin-bottom: 25px;
}
.hero-copy {
  padding: 30px 32px;
  z-index: 1;
}
.hero-copy h2 {
  font-size: 31px;
  line-height: 1.12;
  letter-spacing: -1px;
  margin-bottom: 12px;
}
.hero-copy h2 em {
  font-family: Georgia, serif;
  font-weight: 400;
  color: #57733e;
}
.hero-copy > p {
  font-size: 11px;
  color: #677760;
  max-width: 330px;
  line-height: 1.8;
  margin-bottom: 20px;
}
.hero-buttons {
  display: flex;
  gap: 8px;
  align-items: center;
}
.hero-art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 215px;
  isolation: isolate;
}
.court {
  position: absolute;
  width: 320px;
  height: 220px;
  border: 1px solid #ccd8b9;
  transform: rotate(-17deg);
  border-radius: 2px;
  opacity: 0.85;
  right: -35px;
  top: 8px;
}
.court:before {
  content: "";
  position: absolute;
  inset: 14px;
  border: 1px solid #c5d4b2;
}
.court:after {
  content: "";
  position: absolute;
  left: 50%;
  height: 100%;
  border-left: 1px solid #c5d4b2;
}
.court-circle {
  width: 85px;
  height: 85px;
  border: 1px solid #c5d4b2;
  border-radius: 50%;
  position: absolute;
  top: 67px;
  left: 117px;
}
.hero-score {
  position: relative;
  background: #fff;
  border: 1px solid #e0e7d8;
  border-radius: 14px;
  box-shadow: 0 15px 30px #3d512817;
  transform: rotate(-4deg);
  width: 245px;
  padding: 19px;
  z-index: 1;
  margin-right: 10px;
}
.score-kicker {
  display: flex;
  justify-content: space-between;
  font-size: 8px;
  color: #839076;
  letter-spacing: 1px;
  margin-bottom: 18px;
}
.score-kicker span {
  color: #5e8041;
}
.score-line {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  font-size: 12px;
}
.score-line b {
  margin-left: auto;
  font-size: 18px;
}
.hero-sticker {
  position: absolute;
  z-index: 2;
  right: 14px;
  bottom: 26px;
  background: var(--lime);
  border: 4px solid #eaf0df;
  border-radius: 50%;
  width: 69px;
  height: 69px;
  display: grid;
  place-items: center;
  transform: rotate(12deg);
}
.hero-sticker .icon {
  width: 26px;
  height: 26px;
}
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 32px;
}
.stat {
  border: 1px solid var(--line);
  background: white;
  border-radius: 12px;
  padding: 17px 18px;
  display: flex;
  flex-direction: column;
}
.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
  font-size: 10px;
}
.stat-top .icon {
  width: 16px;
  height: 16px;
  color: #8e9f81;
}
.stat-number {
  font-size: 29px;
  font-weight: 600;
  letter-spacing: -0.9px;
  margin: 7px 0 2px;
}
.stat-foot {
  font-size: 9px;
  color: #8c9787;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 16px;
}
.section-header h2 {
  margin: 0;
}
.section-sub {
  font-size: 10px;
  color: var(--muted);
  margin: 6px 0 0;
}
.filters {
  display: flex;
  gap: 3px;
  padding: 3px;
  background: #edf0e7;
  border-radius: 8px;
}
.filter {
  border: 0;
  background: none;
  border-radius: 6px;
  padding: 7px 11px;
  font-size: 10px;
  color: var(--muted);
}
.filter.active {
  background: white;
  color: var(--ink);
  box-shadow: 0 1px 3px #25362312;
}
.tournament-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}
.event-card {
  background: white;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 22px;
  position: relative;
  display: flex;
  flex-direction: column;
  transition:
    transform 0.15s,
    box-shadow 0.15s;
}
.event-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 7px 20px #27351d08;
}
.event-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 21px;
}
.sport-symbol {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #f1f4ea;
  font-size: 20px;
}
.sport-symbol.gold {
  background: #fff4dc;
}
.sport-symbol.blue {
  background: #ecf1f9;
}
.sport-symbol.rose {
  background: #f8edeb;
}
.tag {
  font-size: 9px;
  padding: 5px 8px;
  border-radius: 5px;
  background: #f2f4ec;
  color: #78866c;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-weight: 600;
}
.tag i {
  height: 4px;
  width: 4px;
  border-radius: 50%;
  background: currentColor;
}
.tag.active {
  background: #edf4e2;
  color: #5b7d32;
}
.tag.completed {
  background: #e9f2ed;
  color: #36644e;
}
.tag.draft {
  background: #f6f0e2;
  color: #987630;
}
.event-card h3 {
  font-size: 19px;
  line-height: 1.3;
  margin-bottom: 7px;
  font-weight: 620;
  letter-spacing: -0.55px;
}
.event-format {
  font-size: 10px;
  color: var(--muted);
  margin: 0 0 18px;
}
.event-meta {
  display: flex;
  gap: 16px;
  font-size: 10px;
  color: #687768;
  margin-bottom: 18px;
}
.event-meta span {
  display: flex;
  align-items: center;
  gap: 5px;
}
.event-meta .icon {
  width: 13px;
  height: 13px;
}
.progress-track {
  height: 4px;
  background: #eef1e9;
  border-radius: 9px;
  overflow: hidden;
}
.progress-track > span {
  display: block;
  height: 100%;
  background: #a5be77;
  border-radius: 9px;
}
.progress-copy {
  font-size: 9px;
  display: flex;
  justify-content: space-between;
  color: #8b9785;
  margin: 8px 0 21px;
}
.event-card-footer {
  border-top: 1px solid #eef0e9;
  padding-top: 15px;
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.avatar-stack {
  display: flex;
  align-items: center;
  font-size: 9px;
  color: #87927f;
}
.avatar-stack span {
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #e6ecda;
  border: 2px solid white;
  font-size: 7px;
  color: #687953;
  margin-left: -5px;
}
.avatar-stack span:first-child {
  margin-left: 0;
}
.avatar-stack small {
  margin-left: 7px;
  font-size: 8px;
}
.text-button {
  border: 0;
  background: none;
  padding: 0;
  color: var(--ink);
  font-size: 10px;
  font-weight: 650;
  display: flex;
  align-items: center;
  gap: 8px;
}
.text-button .icon {
  width: 14px;
  height: 14px;
}
.note-banner {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 17px 20px;
  background: #f0f2e9;
  border: 1px dashed #d4ddc8;
  border-radius: 12px;
  margin-top: 22px;
}
.note-banner .icon {
  color: #7c9367;
}
.note-banner p {
  margin: 0;
  font-size: 10px;
  color: #76846c;
}
.note-banner strong {
  display: block;
  font-size: 11px;
  color: #435b39;
  margin-bottom: 2px;
}
.note-banner button {
  margin-left: auto;
  white-space: nowrap;
}
.page-footer {
  display: flex;
  justify-content: space-between;
  border-top: 1px solid var(--line);
  padding: 20px 42px;
  font-size: 9px;
  color: #5c705e;
  gap: 15px;
}
.page-footer button {
  border: 0;
  background: none;
  color: #89947f;
  font-size: 9px;
  padding: 0;
}
.toolbar {
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}
.tournament-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 24px;
}
.tournament-heading h1 {
  font-size: 34px;
  margin-bottom: 10px;
}
.tournament-heading p {
  font-size: 11px;
  color: var(--muted);
  max-width: 600px;
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: var(--muted);
  border: 0;
  padding: 0;
  background: none;
  margin-bottom: 20px;
}
.back-link .icon {
  width: 13px;
  height: 13px;
}
.tabs {
  display: flex;
  gap: 25px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 27px;
  overflow: auto;
}
.tab {
  padding: 0 0 15px;
  border: 0;
  border-bottom: 2px solid transparent;
  background: none;
  color: #82907b;
  font-size: 11px;
  white-space: nowrap;
}
.tab.active {
  color: var(--ink);
  border-color: var(--ink);
  font-weight: 700;
}
.overview-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.65fr) minmax(240px, 1fr);
  gap: 22px;
}
.panel {
  background: white;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 23px;
  margin-bottom: 20px;
}
.panel h2 {
  font-size: 17px;
  margin-bottom: 18px;
}
.panel-label {
  font-size: 9px;
  letter-spacing: 1px;
  color: #88947e;
}
.steps {
  display: flex;
  gap: 12px;
  margin-top: 22px;
}
.step {
  flex: 1;
  border-top: 3px solid #e8ecdf;
  padding-top: 12px;
  font-size: 10px;
  color: #87967c;
  line-height: 1.5;
}
.step.done {
  border-color: #a2c66a;
  color: #456238;
}
.step b {
  display: block;
  color: inherit;
  font-size: 11px;
  margin: 7px 0;
}
.details-list {
  margin: 0;
}
.details-list > div {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid #eef0e8;
  padding: 13px 0;
  font-size: 11px;
}
.details-list > div:last-child {
  border: 0;
}
.details-list dt {
  color: var(--muted);
}
.details-list dd {
  margin: 0;
  text-align: right;
  max-width: 65%;
  overflow-wrap: anywhere;
}
.match-row {
  display: flex;
  align-items: center;
  gap: 15px;
  border-top: 1px solid #eef1e9;
  padding: 16px 0;
}
.match-row:first-of-type {
  border-top: 0;
}
.match-row > .match-round {
  width: 54px;
  flex-shrink: 0;
  font-size: 9px;
  color: #87957d;
  line-height: 1.6;
}
.match-players {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
  justify-content: center;
}
.match-player {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 0;
  font-size: 12px;
}
.match-player:last-child {
  justify-content: flex-end;
  text-align: right;
}
.match-player > span:last-child {
  overflow-wrap: anywhere;
}
.avatar {
  display: inline-grid;
  place-items: center;
  background: #ecf0e2;
  color: #657b48;
  font-size: 10px;
  font-weight: 650;
  flex-shrink: 0;
  border-radius: 8px;
  width: 32px;
  height: 32px;
}
.avatar.c1 {
  background: #e9eef5;
  color: #657c98;
}
.avatar.c2 {
  background: #f6ebdf;
  color: #a08765;
}
.avatar.c3 {
  background: #eee9f3;
  color: #8b749d;
}
.score {
  background: #f1f4ea;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 12px;
  letter-spacing: 2px;
  white-space: nowrap;
  font-weight: 650;
}
.match-actions {
  display: flex;
  gap: 5px;
  margin-left: 5px;
}
.match-actions .button {
  font-size: 10px;
  padding: 7px 9px;
}
.match-note {
  font-size: 9px;
  color: var(--muted);
  margin: 0 0 7px 69px;
}
.round-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  font-weight: 650;
  margin: 25px 0 5px;
}
.round-title:first-child {
  margin-top: 0;
}
.round-title span {
  font-size: 9px;
  color: var(--muted);
  font-weight: 400;
}
.table-wrap {
  overflow: auto;
}
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}
th {
  font-size: 9px;
  color: #87927f;
  font-weight: 500;
  letter-spacing: 0.4px;
  background: #f9faf6;
}
td,
th {
  padding: 14px 12px;
  text-align: right;
  border-bottom: 1px solid #edf0e7;
  white-space: nowrap;
}
td:first-child,
th:first-child {
  text-align: center;
  width: 35px;
}
td:nth-child(2),
th:nth-child(2) {
  text-align: left;
}
td:last-child {
  font-weight: 750;
}
tr.qualifier td:first-child {
  border-left: 3px solid #a7c86e;
}
td .avatar {
  width: 25px;
  height: 25px;
  border-radius: 6px;
  margin-right: 9px;
  font-size: 8px;
}
.table-note {
  font-size: 10px;
  line-height: 1.8;
  color: var(--muted);
  margin: 17px 0 0;
}
.table-note .legend-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  background: #a7c86e;
  margin-right: 5px;
}
.groups-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 19px;
}
.groups-grid .panel {
  padding: 18px;
}
.group-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.group-heading h2 {
  margin-bottom: 18px;
}
.group-heading span {
  font-size: 9px;
  color: var(--muted);
}
.roster {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.roster-item {
  display: flex;
  gap: 12px;
  align-items: center;
  border: 1px solid var(--line);
  background: white;
  border-radius: 10px;
  padding: 15px;
}
.roster-item strong {
  font-size: 12px;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.roster-item small {
  font-size: 9px;
  color: var(--muted);
  display: block;
  margin-top: 4px;
}
.roster-item .icon-button {
  margin-left: auto;
  color: #88967d;
}
.roster-item .icon {
  width: 15px;
  height: 15px;
}
.inline-form {
  display: flex;
  gap: 10px;
  max-width: 500px;
  margin-bottom: 23px;
}
.inline-form input {
  flex: 1;
}
.empty {
  text-align: center;
  padding: 45px 20px;
  color: var(--muted);
  font-size: 12px;
}
.empty h2 {
  color: var(--ink);
  font-size: 23px;
}
.empty .icon {
  width: 35px;
  height: 35px;
  color: #a3b983;
  margin-bottom: 12px;
}
.empty .button {
  margin-top: 10px;
}
.champion-banner {
  display: flex;
  align-items: center;
  gap: 20px;
  background: var(--dark);
  color: white;
  border-radius: 14px;
  padding: 25px 28px;
  margin-bottom: 25px;
}
.champion-banner .icon {
  color: var(--lime);
  width: 34px;
  height: 34px;
}
.champion-banner small {
  color: #c2d88b;
  letter-spacing: 2px;
  font-size: 9px;
}
.champion-banner h2 {
  font-size: 27px;
  margin: 5px 0 0;
}
.champion-banner p {
  font-size: 11px;
  margin: 0 0 0 auto;
  color: #b3c3ad;
}
.bracket-scroll {
  overflow: auto;
  max-width: 100%;
  border-radius: 14px;
  background: #f0f3e9;
  border: 1px solid var(--line);
  padding: 25px 23px;
}
.bracket-tree {
  position: relative;
}
.bracket-tree > svg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.bracket-title {
  position: absolute;
  font-size: 10px;
  letter-spacing: 1.3px;
  color: #78896d;
  text-transform: uppercase;
}
.bracket-card {
  position: absolute;
  background: white;
  border: 1px solid #dce3d3;
  border-radius: 10px;
  padding: 7px 10px;
  width: 246px;
  height: 84px;
  text-align: left;
  box-shadow: 0 3px 6px #1d342409;
}
.bracket-card.ready:hover {
  border-color: #83a94a;
}
.bracket-card.completed {
  border-left: 3px solid #a5c66c;
}
.bracket-card.bye {
  background: #f8faf4;
}
.bracket-team {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 10px;
  height: 29px;
}
.bracket-team + .bracket-team {
  border-top: 1px solid #f0f2ea;
}
.bracket-team .avatar {
  width: 20px;
  height: 20px;
  border-radius: 5px;
  font-size: 7px;
}
.bracket-team .team-name {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.bracket-team.winner {
  color: #426a28;
  font-weight: 750;
}
.bracket-status {
  position: absolute;
  right: 9px;
  bottom: -15px;
  font-size: 7px;
  color: #7f9173;
}
.tree-help {
  font-size: 10px;
  color: var(--muted);
  margin: 15px 0 0;
}
.timeline-item {
  display: flex;
  gap: 10px;
  font-size: 10px;
  margin-top: 15px;
  align-items: start;
}
.timeline-item i {
  width: 5px;
  height: 5px;
  background: #b8cb9c;
  border-radius: 50%;
  margin-top: 4px;
  flex-shrink: 0;
}
.timeline-item small {
  display: block;
  color: #9ba58f;
  font-size: 8px;
  margin-top: 4px;
}
.loading {
  padding: 130px 20px;
  text-align: center;
  color: var(--muted);
  font-size: 12px;
}
.spinner {
  width: 28px;
  height: 28px;
  border: 2px solid #dce6ce;
  border-top-color: #678543;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 16px;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
dialog {
  border: 1px solid #e2e6d9;
  border-radius: 18px;
  width: min(670px, calc(100% - 28px));
  max-height: 90vh;
  box-shadow: 0 30px 100px #0a1e2650;
  padding: 0;
  color: var(--ink);
  background: var(--paper);
}
dialog::backdrop {
  background: #13272088;
  backdrop-filter: blur(4px);
}
.modal-header {
  padding: 24px 28px 18px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  border-bottom: 1px solid var(--line);
}
.modal-header h2 {
  font-size: 23px;
  margin: 6px 0 3px;
}
.modal-header .eyebrow {
  font-size: 8px;
  margin: 0;
}
.modal-body {
  padding: 24px 28px;
}
.modal-footer {
  padding: 18px 28px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  gap: 10px;
  background: #fafbf7;
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}
.form-grid .full {
  grid-column: 1/-1;
}
label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 11px;
  font-weight: 600;
}
input,
textarea,
select {
  border: 1px solid #dce3d3;
  border-radius: 8px;
  background: #fbfcf8;
  padding: 11px 12px;
  color: var(--ink);
  width: 100%;
  font-size: 12px;
}
textarea {
  resize: vertical;
  min-height: 115px;
  line-height: 1.6;
}
input::placeholder,
textarea::placeholder {
  color: #9aa58f;
}
.field-help {
  font-size: 10px;
  color: var(--muted);
  line-height: 1.7;
  margin: 12px 0 0;
}
.wizard-steps {
  display: flex;
  gap: 8px;
  margin-bottom: 23px;
}
.wizard-step {
  flex: 1;
  font-size: 9px;
  color: #98a48e;
  border-top: 3px solid #e9eddf;
  padding-top: 8px;
}
.wizard-step.active {
  border-color: #a2bc6c;
  color: #4d7136;
}
.format-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 9px;
}
.format-option {
  border: 1px solid #e0e6d7;
  border-radius: 9px;
  padding: 14px 10px;
  display: flex;
  gap: 10px;
  font-weight: 500;
  line-height: 1.4;
  font-size: 10px;
}
.format-option:has(input:checked) {
  background: #f0f6e4;
  border-color: #98b76a;
}
.format-option input {
  width: 12px;
  height: 12px;
  accent-color: #628b3e;
  margin: 0;
}
.format-option small {
  display: block;
  font-size: 9px;
  color: #8b987c;
  margin-top: 6px;
}
.format-option > span {
  display: block;
}
.format-options legend {
  font-size: 11px;
}
.format-fieldset {
  border: 0;
  padding: 0;
  margin: 20px 0;
}
.format-fieldset legend {
  font-size: 11px;
  font-weight: 600;
  margin-bottom: 10px;
}
.checkbox {
  display: flex;
  flex-direction: row;
  align-items: start;
  gap: 9px;
  font-size: 10px;
  color: #897145;
  background: #fbf5e8;
  padding: 12px;
  border-radius: 8px;
  line-height: 1.7;
}
.checkbox input {
  width: 14px;
  height: 14px;
  margin-top: 2px;
  flex-shrink: 0;
  accent-color: #6d8e42;
}
.result-inputs {
  display: grid;
  grid-template-columns: 1fr 30px 1fr;
  gap: 15px;
  align-items: center;
  text-align: center;
  margin: 8px 0 25px;
}
.result-inputs > span {
  color: #97a488;
}
.result-inputs label {
  align-items: center;
  font-size: 12px;
}
.result-inputs input {
  font-size: 30px;
  text-align: center;
  max-width: 110px;
  padding: 15px;
}
.result-inputs .avatar {
  width: 42px;
  height: 42px;
  font-size: 14px;
  margin-bottom: 6px;
}
.result-inputs label > span:not(.avatar) {
  min-height: 32px;
}
.result-schedule {
  margin-top: 25px;
  border-top: 1px solid var(--line);
  padding-top: 18px;
}
.result-schedule summary {
  font-size: 11px;
  cursor: pointer;
  color: #718366;
}
.result-schedule .form-grid {
  margin-top: 17px;
}
.modal-error {
  color: #ae4133;
  font-size: 11px;
  line-height: 1.6;
  padding: 10px 14px;
  background: #fff1eb;
  border-radius: 7px;
  margin-bottom: 15px;
}
.hidden {
  display: none !important;
}
#toast {
  position: fixed;
  bottom: 22px;
  right: 24px;
  z-index: 100;
  max-width: min(430px, calc(100% - 40px));
  padding: 14px 20px;
  background: var(--dark);
  color: white;
  box-shadow: 0 9px 30px #1b2d2333;
  border-radius: 10px;
  font-size: 12px;
  line-height: 1.6;
  display: none;
}
#toast.error {
  background: #983e32;
}
.project-list {
  padding-left: 19px;
  font-size: 12px;
  line-height: 1.9;
  color: #74816a;
}
.share-url {
  display: flex;
  gap: 9px;
  margin-top: 20px;
}
.project-intro {
  font-size: 13px;
  color: #728168;
  line-height: 1.9;
}
.search-box {
  max-width: 260px;
  padding: 8px 11px;
  font-size: 10px;
}
.error-page {
  border: 1px solid #f1d4c6;
  background: #fff6ef;
  border-radius: 14px;
  padding: 30px;
}
.error-page p {
  font-size: 12px;
}
.groups-options {
  margin-top: 17px;
}
@media (min-width: 1550px) {
  main {
    padding-top: 45px;
  }
  .hero {
    min-height: 255px;
  }
  .hero-copy {
    padding: 35px 38px;
  }
  .hero-copy h2 {
    font-size: 36px;
  }
  .hero-score {
    width: 280px;
  }
  .event-card {
    padding: 26px;
  }
  .event-card h3 {
    font-size: 22px;
  }
}
@media (max-width: 1150px) {
  .sidebar {
    width: 220px;
    padding: 27px 18px 0;
  }
  .app-shell {
    margin-left: 220px;
  }
  main {
    padding: 29px 26px;
  }
  .topbar {
    padding: 0 26px;
  }
  .top-actions {
    gap: 12px;
  }
  .hero {
    grid-template-columns: 1.2fr 1fr;
  }
  .hero-copy {
    padding: 25px;
  }
  .hero-copy h2 {
    font-size: 28px;
  }
  .hero-score {
    width: 200px;
  }
  .hero-sticker {
    right: 0;
  }
  .hero-art {
    overflow: hidden;
  }
  .hero-buttons {
    flex-wrap: wrap;
  }
  .stat-grid {
    gap: 10px;
  }
  .stat {
    padding: 15px;
  }
  .event-card {
    padding: 19px;
  }
  .event-meta {
    gap: 10px;
  }
  .overview-grid {
    grid-template-columns: 1fr;
  }
  .groups-grid {
    grid-template-columns: 1fr;
  }
  .page-footer {
    padding: 18px 26px;
  }
  .tournament-heading {
    flex-direction: column;
  }
  .match-player {
    font-size: 11px;
  }
}
@media (max-width: 800px) {
  .sidebar {
    width: 215px;
    visibility: hidden;
    transform: translateX(-100%);
    transition: transform 0.2s;
  }
  .sidebar.open {
    visibility: visible;
    transform: translateX(0);
    box-shadow: 15px 0 50px #18292344;
  }
  .app-shell {
    margin-left: 0;
  }
  #mobile-menu {
    display: inline-flex;
  }
  .topbar {
    height: 65px;
    padding: 0 20px;
  }
  .demo-label {
    display: none;
  }
  .breadcrumb {
    gap: 10px;
  }
  main {
    padding: 25px 20px;
  }
  .page-heading h1 {
    font-size: 30px;
  }
  .hero {
    grid-template-columns: 1.1fr 1fr;
  }
  .stat-grid {
    margin-bottom: 25px;
  }
  .page-footer {
    padding: 20px;
  }
  .date-note {
    display: none;
  }
  .hero-copy {
    padding: 25px;
  }
  .hero-score {
    width: 210px;
  }
  .roster {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 560px) {
  .topbar {
    padding: 0 15px;
  }
  .breadcrumb > span:first-of-type,
  .crumb-slash {
    display: none;
  }
  main {
    padding: 24px 15px;
  }
  .top-actions .button {
    font-size: 10px;
    padding: 8px 10px;
  }
  .top-actions .icon {
    width: 13px;
  }
  .page-heading {
    margin-bottom: 22px;
  }
  .page-heading h1 {
    font-size: 29px;
  }
  .hero {
    grid-template-columns: 1fr;
    min-height: 0;
  }
  .hero-copy {
    padding: 25px;
  }
  .hero-copy h2 {
    font-size: 32px;
  }
  .hero-copy > p {
    max-width: 100%;
  }
  .hero-art {
    min-height: 185px;
    margin-top: -5px;
  }
  .hero-score {
    width: 220px;
    transform: rotate(-3deg);
    margin: 0 0 26px;
  }
  .court {
    right: 10px;
    top: -20px;
  }
  .hero-sticker {
    right: 28px;
    bottom: 20px;
  }
  .stat-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .stat {
    padding: 16px;
  }
  .stat-number {
    font-size: 28px;
  }
  .section-header {
    align-items: flex-start;
    gap: 10px;
    flex-wrap: wrap;
  }
  .section-header h2 {
    font-size: 19px;
  }
  .tournament-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .event-card {
    padding: 22px;
  }
  .event-card h3 {
    font-size: 20px;
  }
  .event-card-top {
    margin-bottom: 17px;
  }
  .note-banner {
    align-items: flex-start;
    flex-wrap: wrap;
    padding: 16px;
  }
  .note-banner button {
    margin-left: 33px;
  }
  .page-footer {
    flex-direction: column;
    font-size: 8px;
    gap: 9px;
  }
  .page-footer button {
    text-align: left;
  }
  .tournament-heading h1 {
    font-size: 29px;
  }
  .tournament-heading {
    gap: 7px;
  }
  .tabs {
    gap: 22px;
  }
  .panel {
    padding: 17px;
  }
  .match-row {
    gap: 8px;
    flex-wrap: wrap;
    position: relative;
    padding: 17px 0;
  }
  .match-row > .match-round {
    width: 100%;
    font-size: 8px;
  }
  .match-players {
    width: 100%;
    flex: none;
    gap: 7px;
  }
  .match-player {
    font-size: 11px;
  }
  .match-player .avatar {
    width: 25px;
    height: 25px;
    font-size: 8px;
  }
  .match-actions {
    margin-left: auto;
  }
  .match-note {
    margin-left: 0;
  }
  .roster {
    grid-template-columns: 1fr;
  }
  .inline-form {
    flex-wrap: wrap;
  }
  .inline-form input {
    min-width: 180px;
  }
  .form-grid {
    grid-template-columns: 1fr;
  }
  .form-grid .full {
    grid-column: auto;
  }
  .format-options {
    grid-template-columns: 1fr;
  }
  .format-option {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    gap: 9px;
  }
  .format-option small {
    display: inline;
    margin-left: 7px;
  }
  .modal-header,
  .modal-body {
    padding: 21px;
  }
  .modal-footer {
    padding: 16px 21px;
  }
  .modal-footer .button {
    padding: 10px 13px;
    font-size: 11px;
  }
  .result-inputs {
    gap: 8px;
  }
  .result-inputs label {
    font-size: 10px;
  }
  .result-inputs input {
    width: 85px;
  }
  .result-schedule .form-grid {
    grid-template-columns: 1fr;
  }
  .champion-banner {
    padding: 21px;
    gap: 15px;
    flex-wrap: wrap;
  }
  .champion-banner p {
    margin-left: 50px;
  }
  .champion-banner h2 {
    font-size: 23px;
  }
  .steps {
    gap: 9px;
  }
  .step {
    font-size: 9px;
  }
  .share-url {
    flex-wrap: wrap;
  }
  .search-box {
    max-width: 100%;
  }
  .bracket-scroll {
    padding: 20px 16px;
  }
  .toolbar .button {
    font-size: 10px;
    padding: 9px 12px;
  }
}
@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
  }
}
